// =============================================================================
// Kura Vault — canonical database schema (DBML)
// =============================================================================
//
// Source of truth:
//   backend/src/database/migrations/1775240947512-InitialSchema.ts
//   backend/src/modules/*/entities/*.entity.ts   (9 files; agree exactly with the migration)
//   backend/src/common/types/index.ts            (enums)
//
// This file DOCUMENTS the schema; it is not executed. The ORM is TypeORM, not
// Prisma. Enum names match the Postgres types TypeORM generates.
//
//   View:      paste into https://dbdiagram.io  (or Import > DBML)
//   Validate:  npx -p @dbml/cli dbml2sql docs/database/schema.dbml --postgres
//
// -----------------------------------------------------------------------------
// Where this file differs from the live database
// -----------------------------------------------------------------------------
// Two Refs at the bottom are NOT enforced by the database. The columns exist as
// bare uuid with no FOREIGN KEY constraint. They are drawn here (grey lines)
// because the relationship is real in application code:
//   albums.cover_media_id        > media.id   [delete: set null]
//   invite_codes.used_by_user_id > users.id   [delete: set null]
// The other 10 Refs are real constraints from the migration, all
// ON DELETE CASCADE / ON UPDATE NO ACTION.
//
// Two things DBML cannot express, both on albums:
//   uq_albums_liked_owner_vault is a PARTIAL unique index (WHERE kind = 'liked').
//   chk_albums_kind is a CHECK constraint. See the albums table note.
//
// -----------------------------------------------------------------------------
// Known issues (recorded here, not fixed)
// -----------------------------------------------------------------------------
// 1. docs/design/0001-system-design.md §5.2 is stale. It lists 7 tables (no
//    refresh_tokens or invite_codes), leaves out the soft-delete, login-lockout
//    and *_nonce columns, still has media favorite/archive flags, and says
//    Prisma. Trust this file, not that doc.
// 2. Deleting a key_group cascades away its media_vault_access rows. Any media
//    row whose only access row was in that vault is orphaned, along with its
//    S3 blobs. Nothing cleans it up, and nobody can decrypt it anymore.
// 3. media.file_size_bytes is bigint. The pg driver returns bigint as a
//    string, but the entity types the field as number.
// =============================================================================

Project kura_vault {
  database_type: 'PostgreSQL'
  Note: '''
  **Kura Vault**: an end-to-end encrypted photo/video vault.

  - Blobs live in S3, encrypted client-side with a per-media DEK.
  - Each vault (`key_groups`) has a KEK derived from its passphrase with Argon2id.
    The server never sees the passphrase or the KEK.
  - `media_vault_access` stores the DEK wrapped under each vault's KEK, one row
    per (media x vault). Sharing a photo into a vault adds a row there.
    The blob is never re-encrypted.
  - Anything user-meaningful (vault labels, album names, filenames, GPS) is
    ciphertext + nonce. Only structural fields stay plaintext for querying.
  - Likes are per user: each user has a private Liked album in each vault.
  '''
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

Enum users_role_enum {
  owner
  viewer
}

Enum user_vault_access_permission_enum {
  admin
  view
}

Enum media_media_type_enum {
  photo
  video
}

Enum albums_kind_enum {
  regular [note: 'Shared by every member of the vault']
  liked   [note: 'One per user per vault, private to that user']
}

// -----------------------------------------------------------------------------
// Devices & auth
// -----------------------------------------------------------------------------

Table users {
  id                    uuid            [pk, default: `uuid_generate_v4()`]
  name                  varchar(100)    [not null]
  device_id             varchar(255)    [not null, unique]
  password_hash         text            [not null, note: 'bcrypt. API login credential, NOT the vault passphrase']
  role                  users_role_enum [not null, default: 'viewer']
  is_active             boolean         [not null, default: true]
  last_login_at         timestamptz
  failed_login_attempts integer         [not null, default: 0]
  locked_until          timestamptz     [note: 'Login lockout after repeated failures']
  created_at            timestamptz     [not null, default: `now()`]
  updated_at            timestamptz     [not null, default: `now()`]

  Note: '''
  Despite the name, this is a **devices** table: one row per registered device,
  which logs in with device_id + password. MAX_DEVICES = 10 is enforced in
  application code (auth.service.ts), not by the database.

  Liked albums hang off this table, so likes are per device: one person on two
  devices has two separate Liked albums.
  '''
}

Table refresh_tokens {
  id         uuid         [pk, default: `uuid_generate_v4()`]
  token_hash varchar(128) [not null, unique, note: 'SHA-256 of the token. Plaintext is never stored']
  user_id    uuid         [not null]
  device_id  varchar(255) [not null, note: 'Plain copy, not an FK to users.device_id']
  expires_at timestamptz  [not null]
  is_revoked boolean      [not null, default: false]
  created_at timestamptz  [not null, default: `now()`]

  Note: 'Hashed JWT refresh tokens, one row per issued token.'
}

// -----------------------------------------------------------------------------
// Vaults
// -----------------------------------------------------------------------------

Table key_groups {
  id               uuid        [pk, default: `uuid_generate_v4()`]
  kek_salt         text        [not null, note: 'Argon2id salt, base64. Not secret: sent to clients to derive the KEK']
  kek_verify       text        [not null, note: 'The vault UUID encrypted under the KEK. The client decrypts it to check the passphrase']
  kek_verify_nonce text        [not null]
  label_encrypted  text        [note: 'Vault name encrypted under the KEK. The server cannot read it']
  label_nonce      text
  sort_order       integer     [not null, default: 0]
  created_at       timestamptz [not null, default: `now()`]

  Note: '''
  **The vault.** Each row is one passphrase-protected compartment with its own KEK.
  There is no updated_at column.
  '''
}

Table user_vault_access {
  user_id      uuid                              [not null]
  key_group_id uuid                              [not null]
  permission   user_vault_access_permission_enum [not null, default: 'view']
  created_at   timestamptz                       [not null, default: `now()`]

  indexes {
    (user_id, key_group_id) [pk]
  }

  Note: 'Which devices can open which vaults, and with what permission.'
}

Table invite_codes {
  id              uuid         [pk, default: `uuid_generate_v4()`]
  code_hash       varchar(128) [not null, unique, note: 'SHA-256 of the invite code. Plaintext is never stored']
  key_group_id    uuid         [not null]
  expires_at      timestamptz  [not null]
  is_used         boolean      [not null, default: false]
  used_by_user_id uuid         [note: 'NO FK constraint in the database. See the unenforced Ref below']
  created_at      timestamptz  [not null, default: `now()`]

  Note: 'Invite codes that grant a new device access to a vault. Single use, with an expiry.'
}

// -----------------------------------------------------------------------------
// Media
// -----------------------------------------------------------------------------

Table media {
  // Structural metadata. Plaintext so the server can query it.
  id               uuid                  [pk, default: `uuid_generate_v4()`]
  captured_at      timestamptz
  media_type       media_media_type_enum [not null]
  file_size_bytes  bigint                [note: 'pg driver returns a string; the entity types it as number']
  width            integer
  height           integer
  duration_seconds integer
  aspect_ratio     "double precision"    [note: 'float in the entity']
  year_month       varchar(7)            [note: "e.g. '2024-03'"]

  // S3 object keys for the encrypted blobs
  s3_key_thumb     text                  [not null]
  s3_key_preview   text                  [not null]
  s3_key_original  text                  [not null]

  // IVs. The same for every vault, because the DEK is the same.
  thumb_iv         text                  [not null]
  preview_iv       text                  [not null]
  original_iv      text                  [not null]

  // Soft delete. Likes are per user, so they live in albums, not here.
  is_deleted       boolean               [not null, default: false]
  deleted_at       timestamptz

  // Both are @CreateDateColumn, so they hold the same value on insert
  uploaded_at      timestamptz           [not null, default: `now()`]
  created_at       timestamptz           [not null, default: `now()`]

  indexes {
    year_month  [name: 'idx_media_yearmonth']
    captured_at [name: 'idx_media_captured']
  }

  Note: '''
  One row per encrypted photo or video. There is **no key_group_id** here: the
  only link to a vault is through `media_vault_access`.
  '''
}

Table media_vault_access {
  id             uuid [pk, default: `uuid_generate_v4()`]
  media_id       uuid [not null]
  key_group_id   uuid [not null]
  encrypted_dek  text [not null, note: 'The DEK wrapped under this vault\'s KEK. Base64, ~64 bytes']
  dek_nonce      text [not null]
  encrypted_meta text [note: 'Sensitive metadata (filename, GPS, camera, tags) as JSON, encrypted under the KEK']
  meta_nonce     text

  indexes {
    (media_id, key_group_id) [unique, name: 'uq_media_vault']
    media_id                 [name: 'idx_mva_media']
    key_group_id             [name: 'idx_mva_vault']
  }

  Note: '''
  **Envelope-encryption fan-out.** One row per (media x vault), each holding the
  same DEK wrapped under that vault's KEK. Uses a surrogate uuid PK plus a unique
  constraint on (media_id, key_group_id). There are no timestamp columns.
  '''
}

// -----------------------------------------------------------------------------
// Albums
// -----------------------------------------------------------------------------

Table albums {
  id             uuid             [pk, default: `uuid_generate_v4()`]
  key_group_id   uuid             [not null]
  kind           albums_kind_enum [not null, default: 'regular']
  owner_user_id  uuid             [note: 'NULL = shared with every vault member. Set = private to that user (the Liked album)']
  name_encrypted text             [note: 'Album name encrypted under the KEK. The server cannot read it. NULL for the Liked album']
  name_nonce     text
  cover_media_id uuid             [note: 'NO FK constraint in the database. See the unenforced Ref below']
  sort_order     integer          [not null, default: 0]
  media_count    integer          [not null, default: 0, note: 'Denormalized counter kept by app code. No trigger']
  created_at     timestamptz      [not null, default: `now()`]
  updated_at     timestamptz      [not null, default: `now()`]

  indexes {
    key_group_id                  [name: 'idx_albums_vault']
    (owner_user_id, key_group_id) [unique, name: 'uq_albums_liked_owner_vault']
  }

  Note: '''
  Albums belong to exactly one vault, and come in two kinds:
  - `regular`: shared by everyone with access to the vault. Admins manage them.
  - `liked`: one per (user x vault), private to that user. It holds the photos
    they liked, so two members of a shared vault keep separate likes. Created on
    first use, and changed only through the like/unlike endpoints.

  `uq_albums_liked_owner_vault` is partial: `WHERE kind = 'liked'`.
  `chk_albums_kind` CHECK: a regular album has a name and nonce; a liked album
  has an owner.

  The server cannot see the photos, but it can see which media each user liked.
  '''
}

Table album_media {
  album_id   uuid        [not null]
  media_id   uuid        [not null]
  sort_order integer     [not null, default: 0]
  added_at   timestamptz [not null, default: `now()`]

  indexes {
    (album_id, media_id) [pk]
    media_id [name: 'idx_album_media_media']
    album_id [name: 'idx_album_media_album']
  }

  Note: '''
  Join table for the album <-> media many-to-many relationship. A row in a
  user's Liked album means that user liked the photo.
  '''
}

// -----------------------------------------------------------------------------
// Relationships: real FK constraints from the migration (all ON DELETE CASCADE)
// -----------------------------------------------------------------------------

Ref FK_3ddc983c5f7bcf132fd8732c3f4: refresh_tokens.user_id         > users.id      [delete: cascade]
Ref FK_4910d83415fcd0df7bd4f0cbb5d: user_vault_access.user_id      > users.id      [delete: cascade]
Ref FK_a1e3cdaccb729fa2476a30fa9fa: user_vault_access.key_group_id > key_groups.id [delete: cascade]
Ref FK_a03d62d3b04f42adcd2d09d9e41: invite_codes.key_group_id      > key_groups.id [delete: cascade]
Ref FK_64d98a3c63875d3c957a062b3a7: media_vault_access.media_id     > media.id      [delete: cascade]
Ref FK_50ca7a61b6b287ff989883006b8: media_vault_access.key_group_id > key_groups.id [delete: cascade]
Ref FK_ffbffeb6f4466fc3799f14dad35: albums.key_group_id            > key_groups.id [delete: cascade]
Ref FK_0637f371ceb575dc9f235828b66: albums.owner_user_id           > users.id      [delete: cascade]
Ref FK_846915f9ddbc3350c2ea28b1989: album_media.album_id           > albums.id     [delete: cascade]
Ref FK_e846eea26bfbc6b3c3252a641a1: album_media.media_id           > media.id      [delete: cascade]

// -----------------------------------------------------------------------------
// Relationships: NOT ENFORCED by the database (bare uuid columns, no constraint)
// Drawn so the diagram shows the real relationship. The intended behavior is
// set null: deleting a photo blanks the album cover rather than deleting the
// album, and deleting a user keeps the invite-code audit row.
// -----------------------------------------------------------------------------

Ref: albums.cover_media_id        > media.id [delete: set null, color: #9ca3af]
Ref: invite_codes.used_by_user_id > users.id [delete: set null, color: #9ca3af]

// -----------------------------------------------------------------------------
// Visual grouping
// -----------------------------------------------------------------------------

TableGroup devices_and_auth [color: #0f766e] {
  users
  refresh_tokens
}

TableGroup vaults [color: #7c3aed] {
  key_groups
  user_vault_access
  invite_codes
}

TableGroup media_library [color: #2563eb] {
  media
  media_vault_access
}

TableGroup album_organization [color: #c2410c] {
  albums
  album_media
}
