---
import KuraMark from '../components/KuraMark.astro';
import Base from '../layouts/Base.astro';
import { APP_URL } from '../data/site';
---

<Base title="Page not found | Kura Vault" description="This page does not exist." og="home" noindex>
  <section class="container-page flex flex-col items-center py-28 text-center">
    <span class="flex size-14 items-center justify-center rounded-2xl bg-accent text-accent-ink">
      <KuraMark class="size-8" />
    </span>
    <h1 class="mt-8 text-4xl">This door is locked.</h1>
    <p class="mt-4 max-w-md text-muted">
      The page you are looking for is not here. Looking for your photos? The web app now lives at
      <a href={APP_URL} class="link">kura-app.greytimelabs.com</a>.
    </p>
    <a href="/" class="btn btn-primary mt-8">Back to the home page</a>
  </section>
</Base>
