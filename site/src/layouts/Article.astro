---
// Long-form pages: the security model, comparisons and the policies.
import Base from './Base.astro';
import { breadcrumbs } from '../data/schema';

interface Props {
  title: string;
  description: string;
  og: string;
  heading: string;
  eyebrow: string;
  lede?: string;
  /** Shown as written, e.g. "27 October 2026" */
  updated: string;
  trail: { name: string; path: string }[];
  schema?: Record<string, unknown>[];
  /** "On this page" links, shown beside the text on wide screens */
  toc?: { id: string; label: string }[];
}

const { title, description, og, heading, eyebrow, lede, updated, trail, schema = [], toc = [] } = Astro.props;
---

<Base {title} {description} {og} ogType="article" schema={[breadcrumbs(trail), ...schema]}>
  <article class="container-page pt-12 pb-8 sm:pt-16">
    <nav aria-label="Breadcrumb" class="text-[13px] text-muted">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover:text-ink">Home</a></li>
        {
          trail.map((item, i) => (
            <li class="flex items-center gap-1.5">
              <span aria-hidden="true">/</span>
              {i === trail.length - 1 ? (
                <span aria-current="page">{item.name}</span>
              ) : (
                <a href={item.path} class="hover:text-ink">
                  {item.name}
                </a>
              )}
            </li>
          ))
        }
      </ol>
    </nav>
    <header class="mt-8 max-w-3xl border-b border-line pb-10">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="mt-3 text-4xl leading-[1.12] sm:text-5xl">{heading}</h1>
      {lede && <p class="mt-5 text-lg leading-relaxed text-muted">{lede}</p>}
      <p class="mt-5 text-[13px] text-muted">Last updated {updated}</p>
    </header>
    <div class="mt-10 grid gap-16 lg:grid-cols-[minmax(0,48rem)_1fr]">
      <div class="prose-kura min-w-0">
        <slot />
      </div>
      {
        toc.length > 0 && (
          <nav aria-label="On this page" class="hidden lg:block">
            <div class="sticky top-24 border-l border-line pl-5">
              <p class="eyebrow">On this page</p>
              <ul class="mt-4 space-y-2.5 text-sm text-muted">
                {toc.map((item) => (
                  <li>
                    <a href={`#${item.id}`} class="hover:text-ink">
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </nav>
        )
      }
    </div>
    <slot name="after" />
  </article>
</Base>
