{
  "name": "kura-vault-web",
  "version": "1.0.1",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:api": "playwright test -c playwright.api.config.ts",
    "test:e2e": "playwright test",
    "gen:vectors": "tsx scripts/gen-vectors.ts",
    "e2e:firefox-server": "docker run --rm -d --name kuravault-e2e-firefox -p 127.0.0.1:3999:3000 --ipc=host mcr.microsoft.com/playwright:v1.64.0-noble npx -y playwright@1.64.0 run-server --port 3000 --host 0.0.0.0",
    "test:e2e:firefox-docker": "PW_FIREFOX_WS=ws://127.0.0.1:3999/ playwright test"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-virtual": "^3.14.13",
    "clsx": "^2.1.1",
    "exifr": "^7.1.3",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^1.53.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
