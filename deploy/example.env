# Kura Vault: deployment settings. Copy to .env and fill in every CHANGE_ME,
# or run install.sh, which generates the secrets for you.
# Every variable is described in docs/self-hosting.md.

# ── Release ────────────────────────────────────────────────────────────
# Pin an exact release (e.g. 1.2.0) and change it deliberately to upgrade.
KURA_VERSION=CHANGE_ME
# Images are on GitHub (default) and mirrored on Docker Hub:
# KURA_SERVER_IMAGE=docker.io/greytimelabs/kura-vault-server
# KURA_WEB_IMAGE=docker.io/greytimelabs/kura-vault-web

# ── Address ────────────────────────────────────────────────────────────
# The https:// address users open. TLS is required: browsers only allow the
# web client's encryption on secure pages. Your reverse proxy terminates TLS
# and forwards to HTTP_BIND:HTTP_PORT.
PUBLIC_URL=https://vault.example.com
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# Proxies allowed to report the client address (X-Forwarded-For). Default:
# loopback and private ranges. Set your proxy's address if it is elsewhere.
# TRUSTED_PROXIES=

# ── Secrets ────────────────────────────────────────────────────────────
# Generate each with the command shown. Never reuse them across servers.
# openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
# openssl rand -hex 32
JWT_SECRET=CHANGE_ME
# Creates the owner account on first visit; useless once the owner exists.
# Leave empty to have one printed in `docker compose logs server`.
# openssl rand -base64 33 | tr -d '\n' | tr '+/' '-_'
SETUP_KEY=

# ── Storage ────────────────────────────────────────────────────────────
# Option A (default): bundled Garage, served from PUBLIC_URL. Nothing else to set up.
COMPOSE_PROFILES=garage
AWS_REGION=garage
S3_BUCKET_NAME=kura-blobs
# printf 'GK%s' "$(openssl rand -hex 12)"
AWS_ACCESS_KEY_ID=CHANGE_ME
# openssl rand -hex 32
AWS_SECRET_ACCESS_KEY=CHANGE_ME
# openssl rand -hex 32
GARAGE_RPC_SECRET=CHANGE_ME
S3_ENDPOINT=http://garage:3900
S3_PUBLIC_ENDPOINT=${PUBLIC_URL}
S3_PROXY_UPSTREAM=http://garage:3900
S3_ORIGIN=
# Media files live in a Docker volume; point this at a path to use another disk.
# KURA_MEDIA_DIR=/srv/kura-vault/media

# Option B: your own bucket (AWS S3, Cloudflare R2, Backblaze B2, ...). Comment out
# Option A above, uncomment these, and add a CORS rule to the bucket for PUBLIC_URL
# (methods GET and PUT, header content-type). See docs/self-hosting.md.
# COMPOSE_PROFILES=
# AWS_REGION=auto
# S3_BUCKET_NAME=kura-vault-storage
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_PUBLIC_ENDPOINT=
# S3_PROXY_UPSTREAM=
# S3_ORIGIN=https://<account-id>.r2.cloudflarestorage.com

# ── Database ───────────────────────────────────────────────────────────
POSTGRES_USER=kuravault
POSTGRES_DB=kuravault
# disable for the bundled database; require or verify-full for one elsewhere
POSTGRES_SSL=disable

# ── Optional ───────────────────────────────────────────────────────────
# Requests per minute per client address
# THROTTLE_LIMIT=100
# Extra origins allowed to call the API cross-origin, e.g. a hosted web client
# CORS_ORIGINS=https://vault.example.com,https://web.kuravault.app
