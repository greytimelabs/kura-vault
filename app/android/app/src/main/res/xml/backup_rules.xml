<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older. Backup is already off (allowBackup="false"); these
     rules say the same thing for any tool that reads them instead. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
