<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing this app stores leaves the device, neither to cloud
     backup nor in a device-to-device transfer. Tokens are tied to this
     device's keystore and the thumbnail cache to keys held only in memory. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
