# PostgreSQL (via docker-compose on port 5433)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=kuravault
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=kuravault

# JWT
JWT_SECRET=CHANGE_ME_GENERATE_A_64_CHAR_RANDOM_STRING
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# AWS S3 (placeholder for local dev)
AWS_REGION=auto
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=kura-vault-storage
S3_PRESIGNED_EXPIRY=60

# App
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Password Hashing
HASH_SALT_ROUNDS=12
