# Local development. A deployed server is configured through deploy/example.env
# (see docs/self-hosting.md); every variable is described there.

# Run environment: development | test | production (the default when unset)
NODE_ENV=development
PORT=3000

# PostgreSQL (via docker compose in the repository root, on port 5433)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=kuravault
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=kuravault
# disable | require | verify-full (with POSTGRES_SSL_CA_FILE for a private CA)
POSTGRES_SSL=disable

# JWT: generate with `openssl rand -hex 32`
JWT_SECRET=CHANGE_ME_GENERATE_A_64_CHAR_RANDOM_STRING
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Storage. AWS S3: set AWS_REGION and leave S3_ENDPOINT empty.
# Cloudflare R2: AWS_REGION=auto, S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com (no bucket in the path)
AWS_REGION=auto
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=kura-vault-storage

# Origins allowed to call the API cross-origin (the dev web client proxies /api, so it needs none)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate limiting: requests per window (seconds)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# bcrypt cost for account passwords
HASH_SALT_ROUNDS=12

# First-run setup key (optional). Needed once, to create the owner account.
# Leave empty and the server generates one and prints it at start.
SETUP_KEY=
