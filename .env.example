# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=kuravault
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=kuravault

# JWT
JWT_SECRET=CHANGE_ME_GENERATE_A_64_CHAR_RANDOM_STRING
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# AWS S3
# For Cloudflare R2: set AWS_REGION=auto, use an R2 API token's keys, and set
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com (no bucket in the path)
# S3_ENDPOINT=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=kura-vault-storage
S3_PRESIGNED_EXPIRY=60

# CloudFront
CLOUDFRONT_DOMAIN=your-cloudfront-domain
CLOUDFRONT_KEY_PAIR_ID=your-key-pair-id
CLOUDFRONT_PRIVATE_KEY_PATH=/app/keys/cloudfront-private-key.pem

# App
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Password Hashing
HASH_SALT_ROUNDS=12
